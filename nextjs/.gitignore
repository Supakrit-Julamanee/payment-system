# Next.js frontend. See https://git-scm.com/docs/gitignore

# dependencies (pnpm). pnpm-lock.yaml and pnpm-workspace.yaml ARE committed.
/node_modules
/.pnpm-store
.pnpm-debug.log*

# Next.js build output
/.next/
/out/
/build

# TypeScript (next-env.d.ts is regenerated by next dev/build)
*.tsbuildinfo
next-env.d.ts

# env files: .env.local holds NEXT_PUBLIC_OMISE_PUBLIC_KEY. Only the example is committed.
.env*
!.env.example

# testing
/coverage
/playwright-report/
/test-results/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.vercel

# editors
.idea/
.vscode/*
!.vscode/extensions.json
