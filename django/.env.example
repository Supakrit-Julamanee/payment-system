DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.trycloudflare.com
# Must start with skey_test_ or Django refuses to start. Never share this key with the frontend.
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_API_BASE=https://api.omise.co
FRONTEND_URL=http://localhost:3000
# Testing only: make the PromptPay QR expire after N seconds instead of Omise's 24 hours,
# so the expiry case can be tried with the sync job. Leave unset for normal behaviour.
# PROMPTPAY_EXPIRES_IN_SECONDS=60

# PostgreSQL and pgAdmin. docker compose reads this file too, so Django and the containers
# share these values. Change the passwords before the first `docker compose up`.
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
